# 复制成 .env 后按需修改；docker compose 会自动读取。
# 采集端上报口令。留空则由服务端自动生成随机口令，写进 data/.token ——
# 公网部署时建议自己设一个长一点的，并在采集端用 WB_TOKEN 对应配好。
WB_TOKEN=

# 对外端口
WB_PORT=8765

# 容器自己采数据（默认开）。设成 0 = 只读看板，数据由采集机推过来。
WB_ALLOW_COLLECT=1

# 常驻巡检：每几小时看一眼，数据过期就补采一轮。设 0 关闭。
WB_COLLECT_EVERY=6

# 基础镜像。国内拉不到 docker.io 时取消注释，改用镜像加速地址。
# 更彻底的办法是给 Docker 配 registry-mirrors（见 DEPLOY.md「国内网络」一节）。
# BASE_IMAGE=docker.1ms.run/library/python:3.12-slim

# 开发模式：静态资源不缓存。docker-compose.override.yml 已默认开启，
# 生产（-f docker-compose.yml 纯镜像形态）不要设。
# WB_DEV=1

# 页面「版本控制」要连接的宿主更新服务端口（dev/agent.py）。
# 只有改了 agent 的监听端口才需要动这个。
# WB_AGENT_PORT=8766

# 更新服务不在这台机器上时，直接给完整地址（默认是容器内的
# http://host.docker.internal:8766，裸机是 http://127.0.0.1:8766）。
# WB_AGENT_URL=http://192.168.1.10:8766

# 容器内更新要连 GitHub。容器里的 127.0.0.1 不是宿主机，写本机地址会连不上。
# 直连不通时会自动探测宿主上的常见代理端口（结果记在 data/git.proxy），
# 想固定指定就取消下面这行的注释：
# WB_GIT_PROXY=http://host.docker.internal:7897

# 构建镜像时 apt 太慢（装 git 那一步），可以换国内源：
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# 构建完成后这个变量就没用了，只在 docker build 阶段生效。
