.tmp/
*.log

# ── 本地环境 ────────────────────────────────────────────────────
.env
.venv/
venv/
__pycache__/
*.py[cod]

# ── 工具与系统杂项 ──────────────────────────────────────────────
.workbuddy/
.DS_Store
Thumbs.db
desktop.ini
